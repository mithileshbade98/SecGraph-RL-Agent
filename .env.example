# SecGraph-RL Agent Environment Configuration
# Copy to .env and customize for your environment

# ===== Local Development =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secgraph123
NEO4J_DATABASE=neo4j

# Embedding Model (local CPU/MPS)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# LLM for Planning (Ollama local)
LLM_PROVIDER=ollama
LLM_MODEL=llama2:7b
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.7

# Agent Topology
AGENT_TOPOLOGY=single  # single | multi

# Random Seeds for Reproducibility
RANDOM_SEED=42
TORCH_SEED=42
NUMPY_SEED=42

# ===== Azure Production (Stubs) =====
# Event Hubs
AZURE_EVENT_HUB_NAMESPACE=secgraph-events.servicebus.windows.net
AZURE_EVENT_HUB_NAME=security-logs
AZURE_EVENT_HUB_CONSUMER_GROUP=$Default

# Azure Data Explorer (Kusto)
AZURE_ADX_CLUSTER=https://secgraph.westus2.kusto.windows.net
AZURE_ADX_DATABASE=SecurityGraph
AZURE_ADX_TABLE=AnomalyEvents

# Cosmos DB (Graph Storage)
AZURE_COSMOS_ENDPOINT=https://secgraph-cosmos.documents.azure.com:443/
AZURE_COSMOS_KEY=PLACEHOLDER_KEY
AZURE_COSMOS_DATABASE=SecurityGraph
AZURE_COSMOS_CONTAINER=IdentityGraph
AZURE_COSMOS_CONSISTENCY_LEVEL=Session
AZURE_COSMOS_PARTITION_KEY=/tenantId

# Azure AI Search (Vector Store)
AZURE_SEARCH_ENDPOINT=https://secgraph-search.search.windows.net
AZURE_SEARCH_KEY=PLACEHOLDER_KEY
AZURE_SEARCH_INDEX=tool-embeddings
AZURE_SEARCH_API_VERSION=2024-07-01

# Azure Monitor / OpenTelemetry
AZURE_MONITOR_CONNECTION_STRING=InstrumentationKey=PLACEHOLDER
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=secgraph-rl-agent

# ===== Paths =====
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
CONFIGS_DIR=./configs

# ===== Monitoring & Drift =====
DRIFT_CHECK_WINDOW_HOURS=24
DRIFT_ALERT_THRESHOLD=0.15
REWARD_EWMA_ALPHA=0.1

# ===== RL Training =====
RL_LEARNING_RATE=1e-5
RL_BATCH_SIZE=4
RL_GRADIENT_ACCUMULATION_STEPS=8
RL_MAX_GRAD_NORM=1.0
RL_WARMUP_STEPS=100

# DPO Specific
DPO_BETA=0.1
DPO_USE_DYNAMIC_BETA=true

# PPO Specific
PPO_EPOCHS=4
PPO_CLIP_RANGE=0.2
PPO_VF_COEF=0.5
PPO_ENT_COEF=0.01

# ===== Feature Flags =====
ENABLE_DRIFT_MONITORING=true
ENABLE_EXPERT_AUDITS=true
ENABLE_GRAPH_REASONING=true
ENABLE_TEMPORAL_FEATURES=true

# ===== Security & PII =====
ENABLE_PII_SCRUBBING=true
PII_FIELDS=email,ip_address,device_id,name
LOG_LEVEL=INFO
